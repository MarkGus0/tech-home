---
import { goLinks, goPath } from "@data/forms";
import type { Locale } from "@data/site";
import type { EventEntry } from "@data/events";

type Props = {
  event: EventEntry;
  locale: Locale;
  source: string;
  index: number;
};

const { event, locale, source, index } = Astro.props;
const cta = goLinks[event.cta];
---
<article class="index-row">
  <p class="index-row__index">0{index}</p>
  <div class="index-row__main">
    <p class="index-row__meta">{event.label[locale]}</p>
    <h3>{event.title[locale]}</h3>
    <p>{event.summary[locale]}</p>
    <a class="text-link" href={goPath(locale, cta.slug, source)}>{cta.label[locale]}</a>
  </div>
</article>
