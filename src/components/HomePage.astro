---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import { goPath } from "@data/forms";
import type { Locale } from "@data/site";
import { pagePath, t } from "@utils/i18n";

type Props = { locale: Locale };
const { locale } = Astro.props;

const readingMap = [
  ["now", "home.nav.now"],
  ["start", "home.nav.start"],
  ["principles", "home.nav.principles"],
  ["status", "home.nav.status"],
  ["join", "home.nav.join"]
] as const;

const entryCards = [
  {
    status: "hero.entry.events.status",
    title: "hero.entry.events.title",
    description: "hero.entry.events.description",
    cta: "hero.entry.events.cta",
    href: pagePath("events", locale),
    variant: "primary"
  },
  {
    status: "hero.entry.project.status",
    title: "hero.entry.project.title",
    description: "hero.entry.project.description",
    cta: "hero.entry.project.cta",
    href: goPath(locale, "project", "home_entry_project"),
    variant: "secondary"
  },
  {
    status: "hero.entry.cobuild.status",
    title: "hero.entry.cobuild.title",
    description: "hero.entry.cobuild.description",
    cta: "hero.entry.cobuild.cta",
    href: goPath(locale, "cobuild", "home_entry_cobuild"),
    variant: "secondary"
  }
] as const;

const workCards = [
  {
    title: "home.now.events.title",
    description: "home.now.events.description",
    link: "home.now.events.link",
    href: pagePath("events", locale)
  },
  {
    title: "home.now.projects.title",
    description: "home.now.projects.description",
    link: "home.now.projects.link",
    href: pagePath("projects", locale)
  },
  {
    title: "home.now.connections.title",
    description: "home.now.connections.description",
    link: "home.now.connections.link",
    href: goPath(locale, "cobuild", "home_now_connections")
  }
] as const;

const startCards = [
  {
    title: "home.start.curious.title",
    description: "home.start.curious.description",
    cta: "home.start.curious.cta",
    href: pagePath("events", locale),
    variant: "secondary"
  },
  {
    title: "home.start.project.title",
    description: "home.start.project.description",
    cta: "home.start.project.cta",
    href: goPath(locale, "project", "home_start_project"),
    variant: "primary"
  },
  {
    title: "home.start.builder.title",
    description: "home.start.builder.description",
    cta: "home.start.builder.cta",
    href: goPath(locale, "cobuild", "home_start_builder"),
    variant: "secondary"
  },
  {
    title: "home.start.partner.title",
    description: "home.start.partner.description",
    cta: "home.start.partner.cta",
    href: pagePath("partners", locale),
    variant: "secondary"
  }
] as const;

const principles = ["maturity", "honesty", "continuity"] as const;

const statusRows = [
  {
    label: "home.status.events.label",
    value: "home.status.events.value",
    cta: "home.status.events.cta",
    href: pagePath("events", locale)
  },
  {
    label: "home.status.projects.label",
    value: "home.status.projects.value",
    cta: "home.status.projects.cta",
    href: pagePath("projects", locale)
  },
  {
    label: "home.status.cobuild.label",
    value: "home.status.cobuild.value",
    cta: "home.status.cobuild.cta",
    href: goPath(locale, "cobuild", "home_status_cobuild")
  },
  {
    label: "home.status.partners.label",
    value: "home.status.partners.value",
    cta: "home.status.partners.cta",
    href: pagePath("partners", locale)
  }
] as const;
---
<BaseLayout locale={locale} page="home">
  <nav class="mobile-section-nav" aria-label={locale === "zh" ? "快速导航" : "Quick navigation"} data-mobile-section-nav>
    {readingMap.map(([id, key]) => <a href={`#${id}`}>{t(key, locale)}</a>)}
  </nav>

  <aside class="reading-map" aria-label={locale === "zh" ? "阅读章节" : "Reading chapters"} data-reading-map>
    <div class="reading-mode-control">
      <button class="reading-mode-toggle" type="button" data-reading-mode-toggle>
        <span class="reading-mode-icon" aria-hidden="true"></span>
        <span class="reading-mode-label">{locale === "zh" ? "逐行阅读" : "Line-by-line"}</span>
      </button>
    </div>
    <nav>
      {readingMap.map(([id, key]) => <a href={`#${id}`}>{t(key, locale)}</a>)}
    </nav>
  </aside>

  <main id="main" class="home-main">
    <section class="hero home-hero" id="home" aria-labelledby="hero-title">
      <div class="hero-shell">
        <div class="hero-copy">
          <h1 id="hero-title" class="reveal" set:html={t("hero.title", locale)} />
          <div class="hero-detail">
            <div class="hero-summary">
              <p class="reveal">{t("hero.summary.1", locale)}</p>
              <p class="reveal">{t("hero.summary.2", locale)}</p>
              <p class="reveal">{t("hero.summary.3", locale)}</p>
            </div>
            <p class="hero-functional reveal">{t("hero.summary.4", locale)}</p>
          </div>

          <div class="hero-entry-heading reveal">
            <p class="hero-entry-kicker">{t("hero.entry.kicker", locale)}</p>
            <h2>{t("hero.entry.title", locale)}</h2>
          </div>
          <div class="hero-entry-grid" aria-label={locale === "zh" ? "现在可以从这里开始" : "Start here"}>
            {entryCards.map((card) => (
              <article class="hero-entry-card reveal">
                <p class="hero-entry-card__status">{t(card.status, locale)}</p>
                <h3>{t(card.title, locale)}</h3>
                <p class="hero-entry-card__description">{t(card.description, locale)}</p>
                <Button href={card.href} variant={card.variant}>{t(card.cta, locale)}</Button>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="home-compact-section home-now-section" id="now" aria-labelledby="now-title">
      <div class="wide-shell">
        <div class="section-intro reveal">
          <p class="home-section-kicker">{t("home.now.kicker", locale)}</p>
          <h2 id="now-title">{t("home.now.title", locale)}</h2>
          <p>{t("home.now.intro", locale)}</p>
        </div>
        <div class="home-feature-grid">
          {workCards.map((card) => (
            <article class="home-feature-card reveal">
              <h3>{t(card.title, locale)}</h3>
              <p>{t(card.description, locale)}</p>
              <a class="text-link" href={card.href}>{t(card.link, locale)}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-compact-section home-start-section" id="start" aria-labelledby="start-title">
      <div class="wide-shell">
        <div class="section-intro reveal">
          <p class="home-section-kicker">{t("home.start.kicker", locale)}</p>
          <h2 id="start-title">{t("home.start.title", locale)}</h2>
          <p>{t("home.start.intro", locale)}</p>
        </div>
        <div class="home-start-grid">
          {startCards.map((card, index) => (
            <article class="home-start-card reveal">
              <p class="home-start-card__index">0{index + 1}</p>
              <h3>{t(card.title, locale)}</h3>
              <p>{t(card.description, locale)}</p>
              <Button href={card.href} variant={card.variant}>{t(card.cta, locale)}</Button>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-compact-section home-principles-section" id="principles" aria-labelledby="principles-title">
      <div class="wide-shell">
        <div class="section-intro reveal">
          <p class="home-section-kicker">{t("home.principles.kicker", locale)}</p>
          <h2 id="principles-title">{t("home.principles.title", locale)}</h2>
        </div>
        <div class="home-principle-grid">
          {principles.map((principle, index) => (
            <article class="home-principle-card reveal">
              <p class="home-principle-card__index">0{index + 1}</p>
              <h3>{t(`home.principles.${principle}.title`, locale)}</h3>
              <p>{t(`home.principles.${principle}.description`, locale)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-compact-section home-status-section" id="status" aria-labelledby="status-title">
      <div class="wide-shell">
        <div class="section-intro reveal">
          <p class="home-section-kicker">{t("home.status.kicker", locale)}</p>
          <h2 id="status-title">{t("home.status.title", locale)}</h2>
          <p>{t("home.status.intro", locale)}</p>
        </div>
        <div class="home-status-list">
          {statusRows.map((row) => (
            <a class="home-status-row reveal" href={row.href}>
              <span class="home-status-row__label">{t(row.label, locale)}</span>
              <span class="home-status-row__value">{t(row.value, locale)}</span>
              <span class="home-status-row__cta">{t(row.cta, locale)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta final-cta--compact home-final-cta" id="join" aria-labelledby="join-title">
      <div class="final-shell">
        <p class="home-section-kicker reveal">{t("home.join.kicker", locale)}</p>
        <h2 id="join-title" class="reveal">{t("home.join.title", locale)}</h2>
        <div class="final-copy home-final-copy">
          <p class="reveal">{t("home.join.p1", locale)}</p>
          <p class="reveal strong-line">{t("home.join.p2", locale)}</p>
        </div>
        <div class="final-actions reveal" aria-label={locale === "zh" ? "加入 TechFlows 的方式" : "Ways to join TechFlows"}>
          <Button href={goPath(locale, "join", "home_final_join")}>{t("join.action.join", locale)}</Button>
          <Button href={goPath(locale, "project", "home_final_project")} variant="secondary">{t("join.action.submit", locale)}</Button>
          <Button href={goPath(locale, "cobuild", "home_final_cobuild")} variant="secondary">{t("join.action.coBuild", locale)}</Button>
        </div>
        <p class="closing-line home-closing-line reveal">{t("home.join.closing", locale)}</p>
      </div>
    </section>
  </main>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const desktopReadingMode = window.matchMedia("(min-width: 1025px)").matches;
    const body = document.body;
    const button = document.querySelector("[data-reading-mode-toggle]");
    const label = button?.querySelector(".reading-mode-label");
    const lines = Array.from(document.querySelectorAll(".reveal"));
    const mapLinks = Array.from(document.querySelectorAll(".reading-map a, .mobile-section-nav a"));
    let active = false;
    let index = -1;

    function text(on: boolean) {
      const isZh = document.documentElement.lang.toLowerCase().startsWith("zh");
      return on ? (isZh ? "显示全部" : "Show all") : (isZh ? "逐行阅读" : "Line-by-line");
    }

    function clearLines() {
      lines.forEach((line) => line.classList.remove("is-line-active", "is-line-read"));
      body.classList.remove("has-js");
      body.classList.remove("is-reading-mode");
    }

    function setActiveNav() {
      const current = lines[index];
      const section = current instanceof Element ? current.closest("section") : null;
      const href = section?.id ? `#${section.id}` : "";
      mapLinks.forEach((link) => {
        const match = link.getAttribute("href") === href;
        if (match) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    function showLine(next: number) {
      if (!active || lines.length === 0) return;
      index = Math.max(0, Math.min(next, lines.length - 1));
      lines.forEach((line, lineIndex) => {
        line.classList.toggle("is-line-read", lineIndex < index);
        line.classList.toggle("is-line-active", lineIndex === index);
      });
      const current = lines[index];
      if (current instanceof Element) {
        const top = current.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: Math.max(0, top - window.innerHeight * 0.28 - 80), behavior: reducedMotion ? "auto" : "smooth" });
      }
      setActiveNav();
    }

    function enable() {
      if (reducedMotion) return;
      active = true;
      body.classList.add("has-js", "is-reading-mode");
      if (label) label.textContent = text(true);
      showLine(0);
    }

    function disable() {
      active = false;
      if (label) label.textContent = text(false);
      clearLines();
    }

    button?.addEventListener("click", () => active ? disable() : enable());
    document.addEventListener("keydown", (event) => {
      if (!active) return;
      if (event.key === "ArrowDown" || event.key === "j") {
        event.preventDefault();
        showLine(index + 1);
      }
      if (event.key === "ArrowUp" || event.key === "k") {
        event.preventDefault();
        showLine(index - 1);
      }
    });
    document.addEventListener("wheel", (event) => {
      if (!active) return;
      event.preventDefault();
      showLine(index + (event.deltaY > 0 ? 1 : -1));
    }, { passive: false });

    if (desktopReadingMode) enable();
  </script>
</BaseLayout>
