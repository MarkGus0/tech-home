---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import EventCard from "@components/EventCard.astro";
import PageCta from "@components/PageCta.astro";
import PageHero from "@components/PageHero.astro";
import PageMain from "@components/PageMain.astro";
import PageSection from "@components/PageSection.astro";
import { goLinks, goPath } from "@data/forms";
import { pastEvents, upcomingEvent } from "@data/events";
import type { Locale } from "@data/site";
import { pagePath, t } from "@utils/i18n";

type Props = { locale: Locale };
const { locale } = Astro.props;
const hopeItems = [
  { title: "events.hope.h1.title", desc: "events.hope.h1.desc" },
  { title: "events.hope.h2.title", desc: "events.hope.h2.desc" },
  { title: "events.hope.h3.title", desc: "events.hope.h3.desc" }
] as const;
---
<BaseLayout locale={locale} page="events">
  <PageMain class="page--events">
    <PageHero title={t("nav.events", locale)}>
      <p>{t("events.hero.p1", locale)}</p>
      <p>{t("events.intro.p1", locale)}</p>
      <p>{t("events.intro.p2", locale)}</p>
    </PageHero>

    <PageSection>
      <div class="chapter-copy">
        <h2>{t("events.upcoming.title", locale)}</h2>
        <article class="index-row index-row--lead">
          <p class="index-row__index">01</p>
          <div class="index-row__main">
            <p class="index-row__meta">{upcomingEvent.status[locale]}</p>
            <h3>{upcomingEvent.title[locale]}</h3>
            <p>{t("events.upcoming.p1", locale)}</p>
            <p>{upcomingEvent.summary[locale]}</p>
            <div class="page-actions">
              <Button href={goPath(locale, upcomingEvent.cta, "events_upcoming_notice")}>{goLinks[upcomingEvent.cta].label[locale]}</Button>
            </div>
          </div>
        </article>
      </div>
    </PageSection>

    <PageSection>
      <div class="chapter-copy">
        <h2>{t("events.hope.title", locale)}</h2>
        <div class="index-list">
          {hopeItems.map((item, index) => (
            <article class="index-row">
              <p class="index-row__index">0{index + 1}</p>
              <div class="index-row__main">
                <h3>{t(item.title, locale)}</h3>
                <p>{t(item.desc, locale)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </PageSection>

    <PageSection>
      <div class="section-intro">
        <h2>{t("events.past.title", locale)}</h2>
        <p>{t("events.past.intro", locale)}</p>
      </div>
      <div class="index-list">
        {pastEvents.map((event, index) => <EventCard event={event} locale={locale} source="events_past_review" index={index + 1} />)}
        <article class="index-row">
          <p class="index-row__index">0{pastEvents.length + 1}</p>
          <div class="index-row__main">
            <p class="index-row__meta">{t("events.past.ongoing", locale)}</p>
            <h3>{t("events.past.event2.title", locale)}</h3>
            <p>{t("events.past.event2.desc", locale)}</p>
            <a class="text-link" href={goPath(locale, "wechat-album", "events_wechat_album")}>{t("events.past.event2.button", locale)}</a>
          </div>
        </article>
      </div>
    </PageSection>

    <PageSection>
      <div class="chapter-copy">
        <h2>{t("events.part.title", locale)}</h2>
        <p>{t("events.part.intro", locale)}</p>
        <div class="index-list">
          <article class="index-row">
            <p class="index-row__index">01</p>
            <div class="index-row__main">
              <h3>{t("events.part.h1.title", locale)}</h3>
              <p>{t("events.part.h1.desc", locale)}</p>
              <a class="text-link" href={goPath(locale, "project", "events_part_project")}>{t("events.part.h1.button", locale)}</a>
            </div>
          </article>
          <article class="index-row">
            <p class="index-row__index">02</p>
            <div class="index-row__main">
              <h3>{t("events.part.h2.title", locale)}</h3>
              <p>{t("events.part.h2.desc", locale)}</p>
              <a class="text-link" href={goPath(locale, "cobuild", "events_part_cobuild")}>{t("events.part.h2.button", locale)}</a>
            </div>
          </article>
          <article class="index-row">
            <p class="index-row__index">03</p>
            <div class="index-row__main">
              <h3>{t("events.part.h3.title", locale)}</h3>
              <p>{t("events.part.h3.desc", locale)}</p>
              <a class="text-link" href={goPath(locale, "partner", "events_part_partner")}>{t("partners.cta.button", locale)}</a>
            </div>
          </article>
        </div>
      </div>
    </PageSection>

    <PageCta title={t("events.cta.title", locale)}>
      <p>{t("events.cta.p1", locale)}</p>
      <p>{t("events.cta.p2", locale)}</p>
      <Fragment slot="actions">
        <Button href={goPath(locale, "join", "events_final_join")}>{t("join.action.join", locale)}</Button>
        <Button href={pagePath("projects", locale)} variant="secondary">{t("events.cta.projects", locale)}</Button>
        <Button href={pagePath("unfino", locale)} variant="secondary">{t("events.cta.button3", locale)}</Button>
      </Fragment>
    </PageCta>
  </PageMain>
</BaseLayout>
