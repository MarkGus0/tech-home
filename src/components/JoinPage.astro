---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import PageCta from "@components/PageCta.astro";
import PageHero from "@components/PageHero.astro";
import PageMain from "@components/PageMain.astro";
import PageSection from "@components/PageSection.astro";
import { goPath } from "@data/forms";
import { site, type Locale } from "@data/site";
import { pagePath, t } from "@utils/i18n";

type Props = { locale: Locale };
const { locale } = Astro.props;

const whoCards = [
  {
    title: "joinPage.who.curious.title",
    description: "joinPage.who.curious.description",
    cta: "joinPage.who.curious.cta",
    href: pagePath("events", locale)
  },
  {
    title: "joinPage.who.project.title",
    description: "joinPage.who.project.description",
    cta: "joinPage.who.project.cta",
    href: goPath(locale, "project", "join_who_project")
  },
  {
    title: "joinPage.who.builder.title",
    description: "joinPage.who.builder.description",
    cta: "joinPage.who.builder.cta",
    href: "#tracks"
  },
  {
    title: "joinPage.who.partner.title",
    description: "joinPage.who.partner.description",
    cta: "joinPage.who.partner.cta",
    href: pagePath("partners", locale)
  }
] as const;

const offerItems = [
  {
    title: "joinPage.offer.meet.title",
    description: "joinPage.offer.meet.description",
    href: pagePath("events", locale),
    cta: "joinPage.offer.meet.cta"
  },
  {
    title: "joinPage.offer.write.title",
    description: "joinPage.offer.write.description",
    href: pagePath("projects", locale),
    cta: "joinPage.offer.write.cta"
  },
  {
    title: "joinPage.offer.step.title",
    description: "joinPage.offer.step.description"
  }
] as const;

const trackCards = [
  {
    title: "home.tracks.job.title",
    description: "home.tracks.job.description",
    cta: "home.tracks.job.cta",
    slug: "job" as const,
    source: "join_track_job"
  },
  {
    title: "home.tracks.school.title",
    description: "home.tracks.school.description",
    cta: "home.tracks.school.cta",
    slug: "school" as const,
    source: "join_track_school"
  },
  {
    title: "home.tracks.city.title",
    description: "home.tracks.city.description",
    cta: "home.tracks.city.cta",
    slug: "city" as const,
    source: "join_track_city"
  }
] as const;
---
<BaseLayout locale={locale} page="join">
  <PageMain class="page--join">
    <PageHero title={t("nav.join", locale)}>
      <p>{t("joinPage.hero.p1", locale)}</p>
      <p>{t("joinPage.hero.p2", locale)}</p>
    </PageHero>

    <PageSection>
      <div class="chapter-copy">
        <h2>{t("joinPage.method.title", locale)}</h2>
        <p>{t("joinPage.method.p1", locale)}</p>
        <p>{t("joinPage.method.p2", locale)}</p>
        <div class="page-actions">
          <Button href={goPath(locale, "join", "join_method_form")}>{t("joinPage.cta.button1", locale)}</Button>
        </div>
      </div>
    </PageSection>

    <PageSection id="who">
      <div class="chapter-copy">
        <h2>{t("joinPage.who.title", locale)}</h2>
        <p>{t("joinPage.who.intro", locale)}</p>
      </div>
      <div class="index-list">
        {whoCards.map((card, index) => (
          <article class="index-row">
            <p class="index-row__index">0{index + 1}</p>
            <div class="index-row__main">
              <h3>{t(card.title, locale)}</h3>
              <p>{t(card.description, locale)}</p>
              <a class="text-link" href={card.href}>{t(card.cta, locale)}</a>
            </div>
          </article>
        ))}
      </div>
    </PageSection>

    <PageSection id="offer">
      <div class="chapter-copy">
        <h2>{t("joinPage.offer.title", locale)}</h2>
        <p>{t("joinPage.offer.intro", locale)}</p>
      </div>
      <div class="index-list">
        {offerItems.map((item, index) => (
          <article class="index-row">
            <p class="index-row__index">0{index + 1}</p>
            <div class="index-row__main">
              <h3>{t(item.title, locale)}</h3>
              <p>{t(item.description, locale)}</p>
              {"cta" in item && item.cta ? <a class="text-link" href={item.href}>{t(item.cta, locale)}</a> : null}
            </div>
          </article>
        ))}
      </div>
      <p class="text-closing-note">{t("joinPage.offer.limit", locale)}</p>
    </PageSection>

    <PageSection id="tracks">
      <div class="chapter-copy">
        <p class="page-kicker">{t("home.tracks.kicker", locale)}</p>
        <h2>{t("home.tracks.title", locale)}</h2>
        <p>{t("home.tracks.intro", locale)}</p>
        <p>{t("joinPage.tracks.intro", locale)}</p>
        <div class="index-list">
          {trackCards.map((card, index) => (
            <article class="index-row">
              <p class="index-row__index">0{index + 1}</p>
              <div class="index-row__main">
                <h3>{t(card.title, locale)}</h3>
                <p>{t(card.description, locale)}</p>
                <a class="text-link" href={goPath(locale, card.slug, card.source)}>{t(card.cta, locale)}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </PageSection>

    <PageCta title={t("joinPage.cta.title", locale)}>
      <Fragment slot="actions">
        <Button href={goPath(locale, "join", "join_final_form")}>{t("joinPage.cta.button1", locale)}</Button>
        <Button href={`mailto:${site.email}`} variant="secondary" external>{t("joinPage.cta.button2", locale)}</Button>
      </Fragment>
      <p class="page-closing" slot="closing">{t("joinPage.cta.closing", locale)}</p>
    </PageCta>
  </PageMain>
</BaseLayout>
