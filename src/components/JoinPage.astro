---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import { goPath } from "@data/forms";
import { site, type Locale } from "@data/site";
import { t, type TranslationKey } from "@utils/i18n";

type Props = { locale: Locale };
const { locale } = Astro.props;

const roles = [
  {
    title: "joinPage.participant.title",
    paragraphs: ["joinPage.participant.p1", "joinPage.participant.p2", "joinPage.participant.p3", "joinPage.participant.p4"],
    recap: "joinPage.principles.participant.desc"
  },
  {
    title: "joinPage.creator.title",
    paragraphs: ["joinPage.creator.p1", "joinPage.creator.p2", "joinPage.creator.p3", "joinPage.creator.p4", "joinPage.creator.p5"],
    recap: "joinPage.principles.creator.desc"
  },
  {
    title: "joinPage.sharer.title",
    paragraphs: ["joinPage.sharer.p1", "joinPage.sharer.p2", "joinPage.sharer.p3", "joinPage.sharer.p4", "joinPage.sharer.p5"],
    recap: "joinPage.principles.sharer.desc"
  },
  {
    title: "joinPage.recorder.title",
    paragraphs: ["joinPage.recorder.p1", "joinPage.recorder.p2", "joinPage.recorder.p3"],
    recap: "joinPage.principles.recorder.desc"
  },
  {
    title: "joinPage.connector.title",
    paragraphs: ["joinPage.connector.p1", "joinPage.connector.p2", "joinPage.connector.p3"],
    recap: "joinPage.principles.connector.desc"
  },
  {
    title: "joinPage.builder.title",
    paragraphs: ["joinPage.builder.p1", "joinPage.builder.p2", "joinPage.builder.p3", "joinPage.builder.p4"],
    recap: "joinPage.principles.builder.desc"
  }
] as const satisfies ReadonlyArray<{
  title: TranslationKey;
  paragraphs: readonly TranslationKey[];
  recap: TranslationKey;
}>;
---
<BaseLayout locale={locale} page="join">
  <main id="main" class="subpage-main subpage-main--join">
    <section class="hero sub-hero">
      <div class="hero-shell">
        <div class="hero-copy">
          <h1>{t("nav.join", locale)}</h1>
          <div class="hero-detail hero-detail--compact">
            <p>{t("joinPage.hero.p1", locale)}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="reading-section">
      <div class="section-shell">
        <div class="chapter-copy">
          <h2>{t("joinPage.method.title", locale)}</h2>
          <p>{t("joinPage.method.p1", locale)}</p>
          <p>{t("joinPage.method.p2", locale)}</p>
          <Button href={goPath(locale, "join", "join_method_form")}>{t("joinPage.cta.button1", locale)}</Button>
        </div>
      </div>
    </section>

    <section class="reading-section">
      <div class="section-shell">
        <div class="chapter-copy">
          <h2>{t("joinPage.place.title", locale)}</h2>
          <p>{t("joinPage.place.p1", locale)}</p>
          <p>{t("joinPage.place.p2", locale)}</p>
        </div>
      </div>
    </section>

    <section class="reading-section" id="roles">
      <div class="section-shell">
        <div class="chapter-copy">
          <h2>{t("joinPage.roles.title", locale)}</h2>
          <p>{t("joinPage.roles.p1", locale)}</p>
          <p>{t("joinPage.roles.p2", locale)}</p>
        </div>
        <div class="index-list">
          {roles.map((role, index) => (
            <article class="index-row index-row--essay">
              <p class="index-row__index">0{index + 1}</p>
              <div class="index-row__main">
                <h3>{t(role.title, locale)}</h3>
                {role.paragraphs.map((key) => <p>{t(key, locale)}</p>)}
              </div>
            </article>
          ))}
        </div>
        <p class="text-closing-note">{t("joinPage.roles.p3", locale)}</p>
      </div>
    </section>

    <section class="reading-section" id="principles">
      <div class="section-shell">
        <div class="chapter-copy">
          <h2>{t("joinPage.principles.title", locale)}</h2>
        </div>
        <div class="index-list">
          {roles.map((role, index) => (
            <article class="index-row">
              <p class="index-row__index">0{index + 1}</p>
              <div class="index-row__main">
                <h3>{t(role.title, locale)}</h3>
                <p>{t(role.recap, locale)}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="text-closing-note">{t("joinPage.principles.closing", locale)}</p>
      </div>
    </section>

    <section class="final-cta final-cta--compact">
      <div class="final-shell">
        <h2>{t("joinPage.cta.title", locale)}</h2>
        <div class="final-actions">
          <Button href={goPath(locale, "join", "join_final_form")}>{t("joinPage.cta.button1", locale)}</Button>
          <Button href={`mailto:${site.email}`} variant="secondary" external>{t("joinPage.cta.button2", locale)}</Button>
        </div>
        <p class="closing-line">{t("joinPage.cta.closing", locale)}</p>
      </div>
    </section>
  </main>
</BaseLayout>
