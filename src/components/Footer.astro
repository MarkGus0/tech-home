---
import { footerLinks, site, type Locale } from "@data/site";
import { goPath } from "@data/forms";
import { pagePath, t } from "@utils/i18n";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
---
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-brand" href={pagePath("home", locale)}>TechFlows</a>
      <p>{t("footer.blurb", locale)}</p>
    </div>
    <nav class="footer-nav" aria-label={t("footer.navLabel", locale)}>
      {footerLinks.map((item) => (
        <a href={item.kind === "page" ? pagePath(item.page, locale) : goPath(locale, item.slug, item.source)}>
          {item.label[locale]}
        </a>
      ))}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
    <p class="footer-tagline">{t("footer.tagline", locale)}</p>
  </div>
</footer>
