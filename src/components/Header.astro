---
import { navItems, pages, site, type Locale, type PageId } from "@data/site";
import { languageName, oppositeLocale, pagePath, t } from "@utils/i18n";

type Props = {
  locale: Locale;
  page?: PageId;
};

const { locale, page } = Astro.props;
const otherLocale = oppositeLocale(locale);
const switchPath = `${(page ? pages[page] : pages.home).paths[otherLocale]}?lang=${otherLocale}`;
const navLabel = t("nav.primaryLabel", locale);
---
<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href={pagePath("home", locale)} aria-label={t("header.brandAria", locale)}>
      <img
        src={site.logoHeader}
        alt="TechFlows"
        width="264"
        height="30"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="header-nav" aria-label={navLabel}>
      {navItems.map((item) => (
        <a href={pagePath(item.page, locale)} aria-current={item.page === page ? "page" : undefined}>
          {item.label[locale]}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <a
        class="lang-toggle header-lang"
        href={switchPath}
        hreflang={otherLocale === "zh" ? "zh-CN" : "en"}
        aria-label={t("lang.switchTo.aria.en", locale)}
      >
        <svg class="lang-toggle__icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18"></path>
          <path d="M12 3a13 13 0 0 1 0 18"></path>
          <path d="M12 3a13 13 0 0 0 0 18"></path>
        </svg>
        <span>{languageName(locale)}</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label={t("nav.menuOpen", locale)}
        aria-expanded="false"
        aria-controls="nav-panel"
        data-menu-toggle
        data-open-label={t("nav.menuOpen", locale)}
        data-close-label={t("nav.menuClose", locale)}
        data-menu-text={t("header.menu", locale)}
        data-close-text={t("header.close", locale)}
      >
        <span class="menu-toggle__label">{t("header.menu", locale)}</span>
        <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="nav-panel" id="nav-panel" data-nav-panel>
  <div class="nav-panel__intro">
    <span>TechFlows</span>
    <small>{t("header.navIntro", locale)}</small>
  </div>
  <nav class="primary-nav" aria-label={navLabel}>
    {navItems.map((item) => (
      <a href={pagePath(item.page, locale)} aria-current={item.page === page ? "page" : undefined}>
        {item.label[locale]}
      </a>
    ))}
  </nav>
  <a
    class="lang-toggle"
    href={switchPath}
    hreflang={otherLocale === "zh" ? "zh-CN" : "en"}
    aria-label={t("lang.switchTo.aria.en", locale)}
  >
    <svg class="lang-toggle__icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18"></path>
      <path d="M12 3a13 13 0 0 1 0 18"></path>
      <path d="M12 3a13 13 0 0 0 0 18"></path>
    </svg>
    <span>{languageName(locale)}</span>
  </a>
</div>
<div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>

<script>
  const header = document.querySelector("[data-header]");
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const navPanel = document.querySelector("[data-nav-panel]");
  const navBackdrop = document.querySelector("[data-nav-backdrop]");
  const menuText = menuToggle?.querySelector(".menu-toggle__label");
  const openLabel = menuToggle?.getAttribute("data-open-label") ?? "";
  const closeLabel = menuToggle?.getAttribute("data-close-label") ?? "";
  const openText = menuToggle?.getAttribute("data-menu-text") ?? "";
  const closeText = menuToggle?.getAttribute("data-close-text") ?? "";

  function focusableItems() {
    if (!(navPanel instanceof HTMLElement)) return [];
    return Array.from(navPanel.querySelectorAll<HTMLElement>("a, button"));
  }

  function setMenu(open: boolean) {
    if (!(header instanceof HTMLElement)) return;
    const wasOpen = header.dataset.open === "true";
    header.dataset.open = String(open);
    menuPanelState(open);
    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.setAttribute("aria-label", open ? closeLabel : openLabel);
    if (menuText) menuText.textContent = open ? closeText : openText;
    document.body.classList.toggle("nav-open", open);

    if (open) {
      queueMicrotask(() => focusableItems()[0]?.focus());
      return;
    }

    if (wasOpen && menuToggle instanceof HTMLElement) {
      menuToggle.focus();
    }
  }

  function menuPanelState(open: boolean) {
    navPanel?.classList.toggle("is-open", open);
    navBackdrop?.classList.toggle("is-visible", open);
    navBackdrop?.setAttribute("aria-hidden", String(!open));
    if (navPanel instanceof HTMLElement) navPanel.inert = !open;
  }

  function onDocumentKeydown(event: KeyboardEvent) {
    const isOpen = header instanceof HTMLElement && header.dataset.open === "true";
    if (event.key === "Escape" && isOpen) {
      setMenu(false);
      return;
    }

    if (!isOpen || event.key !== "Tab") return;

    const focusable = focusableItems();
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  menuPanelState(false);

  menuToggle?.addEventListener("click", () => {
    const isOpen = header instanceof HTMLElement && header.dataset.open === "true";
    setMenu(!isOpen);
  });
  navBackdrop?.addEventListener("click", () => setMenu(false));
  navPanel?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", onDocumentKeydown);
</script>
