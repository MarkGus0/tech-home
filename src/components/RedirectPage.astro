---
import { goLinks, type GoSlug } from "@data/forms";
import { site, type Locale } from "@data/site";
import { pagePath, t } from "@utils/i18n";

type Props = {
  slug: GoSlug;
  locale: Locale;
};

const { slug, locale } = Astro.props;
const link = goLinks[slug];
---
<main class="redirect-shell">
  <img
    src={site.logo}
    alt="TechFlows"
    width="1610"
    height="182"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="redirect-logo"
  />
  <h1>{t("redirect.title", locale)}</h1>
  <p>{t("redirect.heading", locale)}</p>
  <p class="redirect-link-target" data-redirect-target>{link.target}</p>
  <div class="redirect-actions">
    <a class="button button-primary" rel="noopener noreferrer" href={link.target} data-redirect-confirm>{t("redirect.confirm", locale)}</a>
    <a class="button button-secondary" href={pagePath("home", locale)}>{t("redirect.back", locale)}</a>
  </div>
</main>

<script>
  const source = new URLSearchParams(window.location.search).get("source");
  if (!source) {
    /* keep the built href */
  } else {
    const confirmLink = document.querySelector("[data-redirect-confirm]");
    const targetLabel = document.querySelector("[data-redirect-target]");
    if (confirmLink instanceof HTMLAnchorElement) {
      const next = new URL(confirmLink.href);
      next.searchParams.set("tf_source", source);
      confirmLink.href = next.toString();
      if (targetLabel) targetLabel.textContent = confirmLink.href;
    }
  }
</script>
