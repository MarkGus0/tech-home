---
import type { Localized } from "@data/translations";
import type { Locale } from "@data/site";

type Props = {
  items: Array<{ title: Localized<string>; description: Localized<string> }>;
  locale: Locale;
};

const { items, locale } = Astro.props;
---
<div class="index-list">
  {items.map((item, index) => (
    <article class="index-row">
      <p class="index-row__index">0{index + 1}</p>
      <div class="index-row__main">
        <h3>{item.title[locale]}</h3>
        <p>{item.description[locale]}</p>
      </div>
    </article>
  ))}
</div>
