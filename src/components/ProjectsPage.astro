---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import PageCta from "@components/PageCta.astro";
import PageHero from "@components/PageHero.astro";
import PageMain from "@components/PageMain.astro";
import PageSection from "@components/PageSection.astro";
import { goPath } from "@data/forms";
import { projectEmptyState } from "@data/projects";
import type { Locale } from "@data/site";
import { t } from "@utils/i18n";

type Props = { locale: Locale };
const { locale } = Astro.props;
---
<BaseLayout locale={locale} page="projects">
  <PageMain class="page--projects">
    <PageHero title={t("projects.hero.title", locale)}>
      <p>{t("projects.hero.lead", locale)}</p>
    </PageHero>

    <PageSection>
      <div class="chapter-copy">
        <h2>{projectEmptyState.title[locale]}</h2>
        <p>{projectEmptyState.body[locale]}</p>
        <ul class="index-list index-list--plain">
          {projectEmptyState.details.map((item, index) => (
            <li class="index-row">
              <p class="index-row__index">0{index + 1}</p>
              <div class="index-row__main">
                <p>{item[locale]}</p>
              </div>
            </li>
          ))}
        </ul>
        <a class="text-link" href={goPath(locale, "project", "projects_empty_submit")}>{t("projects.empty.submit", locale)}</a>
      </div>
    </PageSection>

    <PageCta title={t("projects.final.title", locale)}>
      <Fragment slot="actions">
        <Button href={goPath(locale, "project", "projects_final_project")}>{t("projects.final.submit", locale)}</Button>
        <Button href={goPath(locale, "join", "projects_final_join")} variant="secondary">{t("projects.final.join", locale)}</Button>
      </Fragment>
    </PageCta>
  </PageMain>
</BaseLayout>
